# Supabase Project URL (found in project settings)
SUPABASE_URL=your_supabase_url

# Supabase Anon Key (for client-side/public access)
SUPABASE_KEY=your_supabase_anon_key

# Supabase Service Role Key (for backend admin access - DO NOT share)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Comma-separated list of allowed origins for CORS (optional)
# ALLOWED_ORIGINS=http://localhost:3000,https://my-app.vercel.app

# Maximum video size allowed in MB (optional)
# MAX_VIDEO_SIZE_MB=500
